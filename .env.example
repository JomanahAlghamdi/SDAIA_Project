# Never commit .env or paste an API key into chat.
OPENROUTER_API_KEY=
# Use `uv run python app.py models` to choose one currently available FREE tool-calling model.
# Use the same concrete model ID for both A and B. No automatic model fallback.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
IF_MAX_STEPS=8
IF_MAX_TOOL_CALLS=20
IF_MAX_REQUEST_TOKENS=32000
IF_MAX_COST_USD=0.05
